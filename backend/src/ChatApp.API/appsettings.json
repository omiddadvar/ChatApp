{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "SqlServer": "Server=localhost,1433;Database=ChatApp;User Id=sa;Password=CHANGE_ME;TrustServerCertificate=True;MultipleActiveResultSets=True",
    "IdentityDb": "Server=localhost,1433;Database=ChatApp_Identity;User Id=sa;Password=CHANGE_ME;TrustServerCertificate=True;MultipleActiveResultSets=True",
    "NotificationDb": "Server=localhost,1433;Database=ChatApp_Notification;User Id=sa;Password=CHANGE_ME;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },

  "Mongo": {
    "ConnectionString": "mongodb://chatapp:CHANGE_ME@localhost:27017",
    "DatabaseName": "ChatApp_Chat"
  },

  "Minio": {
    "Endpoint": "localhost:9000",
    "AccessKey": "minioadmin",
    "SecretKey": "CHANGE_ME",
    "UseSSL": false,
    "BucketName": "chat-attachments",
    "PresignedUrlExpiryMinutes": 60,
    "MaxFileSizeBytes": 10485760
  },

  "Jwt": {
    "Issuer": "ChatApp",
    "Audience": "ChatApp.Client",
    "SigningKey": "CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG_SECRET_KEY",
    "ExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7
  },

  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "ChatApp.API"
    }
  },

  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "http://localhost:4173"
    ]
  },

  "SignalR": {
    "EnableDetailedErrors": false,
    "KeepAliveIntervalSeconds": 15,
    "ClientTimeoutIntervalSeconds": 30,
    "MaximumReceiveMessageSizeBytes": 32768
  }
}