{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information",
      "ChatApp": "Debug"
    }
  },

  "ConnectionStrings": {
    "SqlServer": "Server=localhost,1433;Database=ChatApp;User Id=sa;Password=Your_Strong!Passw0rd;TrustServerCertificate=True;MultipleActiveResultSets=True",
    "IdentityDb": "Server=localhost,1433;Database=ChatApp_Identity;User Id=sa;Password=Your_Strong!Passw0rd;TrustServerCertificate=True;MultipleActiveResultSets=True",
    "NotificationDb": "Server=localhost,1433;Database=ChatApp_Notification;User Id=sa;Password=Your_Strong!Passw0rd;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },

  "Mongo": {
    "ConnectionString": "mongodb://chatapp:Your_Strong!Passw0rd@localhost:27017",
    "DatabaseName": "ChatApp_Chat_Dev"
  },

  "Minio": {
    "Endpoint": "localhost:9000",
    "AccessKey": "minioadmin",
    "SecretKey": "CHANGE_ME",
    "UseSSL": false,
    "BucketName": "chat-attachments",
    "PresignedUrlExpiryMinutes": 60,
    "MaxFileSizeBytes": 10485760
  },

  "Jwt": {
    "Issuer": "ChatApp",
    "Audience": "ChatApp.Client",
    "SigningKey": "super_long_secret_key_at_least_32_chars_minimum_please_change",
    "ExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },

  "SignalR": {
    "EnableDetailedErrors": true,
    "KeepAliveIntervalSeconds": 15,
    "ClientTimeoutIntervalSeconds": 30,
    "MaximumReceiveMessageSizeBytes": 32768
  }
}